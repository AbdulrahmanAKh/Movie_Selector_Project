   <string>
    QDialog { background-color: #141414; }
    QLabel#titleLabel {
        color: white;
        font-size: 38px;
        font-weight: 600;
        letter-spacing: 0.5px;
        padding-top: 25px;
        padding-bottom: 15px;
    }
    QPushButton {
        background-color: #333;
        color: white;
        border-radius: 4px;
        padding: 10px 22px;
        font-weight: bold;
        font-size: 14px;
    }
    QPushButton:hover { background-color: #444; }
    
    QPushButton#editProfilesButton {
        background-color: transparent;
        border: 1px solid #808080;
        color: #808080;
        font-size: 14px;
        letter-spacing: 1px;
        padding: 10px 24px;
        border-radius: 4px;
    }
    QPushButton#editProfilesButton:hover {
        background-color: transparent;
        border: 1px solid #ffffff;
        color: #ffffff;
    }
    QPushButton#addProfileButton {
        background-color: #e50914;
        color: white;
        font-size: 14px;
        font-weight: bold;
        padding: 10px 24px;
        border-radius: 4px;
        border: none;
    }
    QPushButton#addProfileButton:hover {
        background-color: #b80710;
    }
    QScrollArea { background-color: transparent; border: none; }
    QWidget#profileContainer { background-color: transparent; }

    /* --- STYLES FOR DYNAMIC PROFILE CARDS (NETFLIX STYLE) --- */ 
    QFrame#profileCard {
        background-color: transparent;
        border: none;
    }
    QFrame#avatarBox {
        border: 3px solid transparent;
        border-radius: 8px;
        background-color: #222;
    }
    QFrame#avatarBox[hovered="true"] {
        border: 3px solid #ffffff;
    }
    QLabel#profilePic { 
        color: #666;
        font-size: 16px;
        border-radius: 6px;
        background-color: #1a1a1a;
    }
    QLabel#profileName { 
        color: #808080;
        font-weight: 500;
        font-size: 16px;
    }
    QLabel#profileName[hovered="true"] {
        color: #ffffff;
        font-weight: bold;
    }
    QLabel#editOverlay { 
        background-color: rgba(0, 0, 0, 0.65);
        color: white;
        font-size: 38px;
        border-radius: 6px;
    }
    /* --- END DYNAMIC STYLES --- */

   </string>
